<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= product.name %> - Product Details
    </title>
    <link rel="stylesheet" href="/styles.css">
</head>

<body>
    <div class="container">
        <a href="/search/products" class="back-button">Back to Search</a>
        <h1>Product Details</h1>

        <div class="product-details-container">
            <%# Randomly interchange format positions (left/right) %>
            <% if (Math.random() < 0.5) { %>
                <%- include("details_variants/a_format.ejs") %>
                <div class="divider"></div>
                <%- include("details_variants/b_format.ejs") %>
            <% } else { %>         
                <%- include("details_variants/b_format.ejs") %>
                <div class="divider"></div>
                <%- include("details_variants/a_format.ejs") %>
            <% } %>
        </div>
    </div>

    <script src="/js/product_details.js"></script>
</body>
</html>