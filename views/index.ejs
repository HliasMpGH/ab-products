<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Search A/B Testing</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="container">
        <header>
            <h1>Product Search</h1>
            <div class="search-container">
                <form action="/search/products" method="GET">
                    <input type="text" id="searchInput" name="name" placeholder="Search for products..." value="<%= searchTerm || '' %>">
                    <button type="submit" id="searchButton">Search</button>
                </form>
            </div>
        </header>

        <main>
            <% if (locals.products && products.length > 0) { %>
                <div class="results-container">
                    <%# Randomly interchange format positions (left/right) %>
                    <% if (Math.random() < 0.5) { %>
                        <%- include("search_variants/a_format.ejs")%>
                        <div class="divider"></div>
                        <%- include("search_variants/b_format.ejs")%>
                    <% } else {%>
                        <%- include("search_variants/b_format.ejs")%>
                        <div class="divider"></div>
                        <%- include("search_variants/a_format.ejs")%>
                    <% } %>
                </div>
            <% } else if (locals.searchTerm) { %>
                <div class="no-results">
                    <p>No products found matching "<%= searchTerm %>"</p>
                </div>
            <% } %>
        </main>
    </div>

    <script src="/js/index.js"></script>
</body>
</html>